{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Renovate config for server-vulnerabilities. Bumps the pinned Trivy release in the Ansible defaults file and keeps GitHub Actions current.",
  "extends": ["config:recommended"],
  "timezone": "UTC",
  "schedule": ["before 6am on monday"],
  "prConcurrentLimit": 3,
  "labels": ["dependencies"],
  "customManagers": [
    {
      "description": "Trivy release pinned in the Ansible role defaults",
      "customType": "regex",
      "fileMatch": ["^ansible/roles/trivy-host-scan/defaults/main\\.yml$"],
      "matchStrings": ["trivy_version:\\s*\"(?<currentValue>[\\d.]+)\""],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "aquasecurity/trivy",
      "extractVersionTemplate": "^v(?<version>.*)$",
      "versioningTemplate": "semver"
    }
  ],
  "packageRules": [
    {
      "description": "GitHub Actions: keep action versions (and their pinned SHAs) up to date",
      "matchManagers": ["github-actions"],
      "automerge": false,
      "commitMessagePrefix": "chore(ci):"
    },
    {
      "description": "Trivy bumps",
      "matchPackageNames": ["aquasecurity/trivy"],
      "commitMessagePrefix": "chore(trivy):"
    }
  ]
}
